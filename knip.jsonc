{
  // Go toolchain binaries used by the backend workflow, not npm dependencies.
  "ignoreBinaries": ["gofmt"],
  "entry": [
    "src/main.tsx",
    "src/router.tsx",
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx",
    // shadcn components are copied in whole; pages use only some exports
    "src/client/components/ui/**",
  ],
  "project": [
    "**/*.{js,mjs,ts,tsx}",
    "!src/routeTree.gen.ts",
    // Skill-bundled scripts, run by hand from the skill's instructions
    "!.agents/**",
    "!.claude/**",
    // The Go server owns backend/ (tracker.js is embedded with go:embed)
    "!backend/**",
  ],
  "ignoreDependencies": [
    // Tailwindcss used via @tailwindcss/vite plugin
    "tailwindcss",
    // Imported by app.css; shadcn is also the component CLI
    "tw-animate-css",
    "shadcn",
    // Brand typeface, imported by app.css
    "@fontsource-variable/plus-jakarta-sans",
  ],
}
