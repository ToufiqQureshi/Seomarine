# Seomarine server settings. Copy to .env for local development.
# Secrets live in Railway variables in production, never in the repo.

# --- Required -----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seomarine
REDIS_URL=redis://localhost:6379/0
# At least 32 characters. Signs session cookies and email tokens.
BETTER_AUTH_SECRET=
# Public origin of the site, no path.
PUBLIC_URL=http://localhost:8080
# Sign-in, sign-up and the hosted product need this.
AUTH_MODE=hosted
BETTER_AUTH_URL=http://localhost:8080

# --- Optional -----------------------------------------------------------------
# PORT=8080
# STATIC_DIR=dist
# TRUSTED_PROXY_CIDRS=

# Seomarine's own provider keys (customers never bring their own).
# DATAFORSEO_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Google sign-in, Search Console and Analytics.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Razorpay billing. Set all four or none.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_ID_PRO=
# Credits (USD) granted on every paid subscription charge.
# BILLING_MONTHLY_CREDITS_USD=

# Loops transactional email (verification, reset, invitations).
# LOOPS_API_KEY=
# LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=
# LOOPS_TRANSACTIONAL_INVITATION_ID=

# Sign-up captcha. TURNSTILE_SITE_KEY is read by the frontend build.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# Browser-side analytics.
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Token OpenAI Apps expects at /.well-known/openai-apps-challenge.
# OPENAI_APPS_CHALLENGE=
