# Uplumo server settings. Copy to .env for local development.
# Secrets live in Railway variables in production, never in the repo.

# --- Required -----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uplumo
REDIS_URL=redis://localhost:6379/0
# At least 32 characters. Signs session cookies and email tokens.
BETTER_AUTH_SECRET=
# Public origin of the site, no path.
PUBLIC_URL=http://localhost:8080
# Sign-in, sign-up and invitation links need this.
BETTER_AUTH_URL=http://localhost:8080

# --- Optional -----------------------------------------------------------------
# PORT=8080
# STATIC_DIR=frontend/dist
# TRUSTED_PROXY_CIDRS=

# Uplumo's own provider keys (customers never bring their own).
# DATAFORSEO_API_KEY=
# Google Cloud API key with the PageSpeed Insights API enabled. Free; without
# it site audits skip the page speed test.
# PAGESPEED_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Google sign-in, Search Console and Analytics.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional public Supabase Storage bucket for content editor image uploads.
# Configure the bucket as public, allow image/webp only, and cap objects at 1 MB.
# Keep the service-role key server-side; never add it to a VITE_ variable.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_CONTENT_IMAGE_BUCKET=content-images

# Razorpay billing. Set all four or none.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# One id per plan sold; the amount on each must match internal/plans/catalog.go.
# RAZORPAY_PLAN_ID_BASIC=
# RAZORPAY_PLAN_ID_PRO=
# RAZORPAY_PLAN_ID_AGENCY=
# Stops every paid DataForSEO and AI request for the rest of the UTC day once
# that day's provider spend reaches it. Default 100. Each workspace also has
# its own daily limit, so this is only an emergency stop.
# PROVIDER_DAILY_LIMIT_USD=

# Owner and team addresses whose own workspaces are never limited by a plan.
# STAFF_EMAILS=

# Loops transactional email (verification, reset, invitations).
# LOOPS_API_KEY=
# LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=
# LOOPS_TRANSACTIONAL_INVITATION_ID=

# Sign-up captcha. TURNSTILE_SITE_KEY is read by the frontend build.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# Browser-side analytics.
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Error reporting. Unset means errors stay in the logs only.
# SENTRY_DSN=

# Token OpenAI Apps expects at /.well-known/openai-apps-challenge.
# OPENAI_APPS_CHALLENGE=
