{
  "name": "uplumo",
  "private": true,
  "sideEffects": false,
  "version": "0.1.10",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview --port 3001",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --type-aware --fix",
    "types:check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "sourcemaps:upload": "POSTHOG_SOURCEMAPS=true NODE_OPTIONS=--max-old-space-size=8192 npm run build && pnpm dlx @posthog/cli sourcemap inject --directory ./dist-sourcemaps && pnpm dlx @posthog/cli sourcemap upload --directory ./dist-sourcemaps",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "ci:check": "prettier --check . && knip && tsc --noEmit && oxlint . --type-aware"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.211",
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "1.6.22",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/query-core": "^5.103.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.199",
    "better-auth": "^1.6.22",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^0.542.0",
    "papaparse": "^5.5.3",
    "posthog-js": "^1.395.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.33.6",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.16",
    "tldts": "^7.0.25",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "^22.18.13",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "cheerio": "^1.2.0",
    "knip": "^5.88.1",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.15.0",
    "prettier": "^3.6.2",
    "shadcn": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  }
}
